{
  "name": "gemini-stitch-mcp",
  "version": "1.2.0",
  "description": "Unified MCP server for Gemini AI code generation and Google Stitch design, with pipeline tools for design-to-code workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gemini-stitch-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run typecheck && npm run lint && npm run build && npm run test:coverage"
  },
  "keywords": [
    "mcp",
    "gemini",
    "stitch",
    "claude-code",
    "ui-generation",
    "google",
    "design-to-code"
  ],
  "author": "Alex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexxenn/gemini-stitch-mcp.git"
  },
  "homepage": "https://github.com/alexxenn/gemini-stitch-mcp#readme",
  "bugs": {
    "url": "https://github.com/alexxenn/gemini-stitch-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^10.1.0",
    "eslint-plugin-n": "^17.24.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^2.0.0"
  }
}
